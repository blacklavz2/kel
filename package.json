{
  "name": "keltostv",
  "version": "1.0.0",
  "description": "keltostv",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "tv.keltos.app",
    "productName": "keltostv",
    "files": [
      "main.js",
      "index.html",
      "patches/**"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "keltostv.exe"
    }
  }
}